MONGODB_URI=mongodb://127.0.0.1:27017/pastepro
JWT_SECRET=replace-with-a-long-random-secret

# Playground Query section ke liye — https://console.x.ai/team/default/api-keys
XAI_API_KEY=xai-your-key-here
XAI_MODEL=grok-4-fast

# Optional — sirf tab chahiye jab YouTube "Sign in to confirm you're not a
# bot" ya HTTP 429 de raha ho (aam taur par cloud/datacenter IP se, jaise
# Render/Railway/AWS). Ek real browser se cookies.txt export karo aur uska
# path yahan set karo. Render par: Secret Files mein file upload karo (e.g.
# path /etc/secrets/cookies.txt) aur COOKIES_PATH usi path par set karo.
# COOKIES_PATH=/etc/secrets/cookies.txt

# Optional — cookies + retries YouTube ka bot-check kam karte hain lekin
# 100% guarantee nahi dete, kyunki wo IP-reputation based hai (cloud/
# datacenter IPs jaise Render ko Google zyada suspicious samajhta hai). Agar
# ye baar-baar ho raha hai toh ek proxy provider (Webshare, Bright Data,
# IPRoyal, etc.) se residential/mobile proxy lo aur uska URL yahan daalo —
# tabhi yt-dlp ke requests Render ki IP se nahi, proxy ki IP se jaayenge.
# YTDLP_PROXY=http://user:pass@proxy-host:port

# Optional — only needed if whisper.cpp isn't at the Docker image's default
# path (/opt/whisper/whisper-cli + ggml-tiny.en.bin). Powers word-by-word
# captions for platforms that don't provide their own (Instagram, and
# Twitter/TikTok when that specific video has none) by transcribing the
# downloaded file locally. Leave unset in local dev — captions for those
# platforms just stay empty, exactly like before this existed.
# WHISPER_BIN=/opt/whisper/whisper-cli
# WHISPER_MODEL=/opt/whisper/ggml-tiny.en.bin
