MONGODB_URI=mongodb://127.0.0.1:27017/pastepro
JWT_SECRET=replace-with-a-long-random-secret

# Forgot-password emails — sent via Gmail SMTP (nodemailer). GMAIL_USER is
# the sending Gmail address; GMAIL_APP_PASSWORD is a 16-char App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords),
# NOT the actual Gmail login password. Without these set, /api/auth/
# forgot-password logs the reset link instead of emailing it, so local
# dev still works without real credentials.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Base URL used to build the reset link inside the email — set this to
# the real deployed URL in production (e.g. https://pastepro.onrender.com).
APP_URL=http://localhost:3002

# Playground Query section ke liye — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Defaults are free-tier models (verified working directly against the
# live API). Free models share a rate-limited pool, so a fallback model
# is used if the primary one is busy — override either if needed.
# OPENROUTER_MODEL=minimax/minimax-m3:free
# OPENROUTER_FALLBACK_MODEL=cohere/north-mini-code:free

# Optional — sirf tab chahiye jab YouTube "Sign in to confirm you're not a
# bot" ya HTTP 429 de raha ho (aam taur par cloud/datacenter IP se, jaise
# Render/Railway/AWS). Ek real browser se cookies.txt export karo aur uska
# path yahan set karo. Render par: Secret Files mein file upload karo (e.g.
# path /etc/secrets/cookies.txt) aur COOKIES_PATH usi path par set karo.
# COOKIES_PATH=/etc/secrets/cookies.txt

# Optional — cookies + retries YouTube ka bot-check kam karte hain lekin
# 100% guarantee nahi dete, kyunki wo IP-reputation based hai (cloud/
# datacenter IPs jaise Render ko Google zyada suspicious samajhta hai). Agar
# ye baar-baar ho raha hai toh ek proxy provider (Webshare, Bright Data,
# IPRoyal, etc.) se residential/mobile proxy lo aur uska URL yahan daalo —
# tabhi yt-dlp ke requests Render ki IP se nahi, proxy ki IP se jaayenge.
# YTDLP_PROXY=http://user:pass@proxy-host:port

# Optional — only needed if whisper.cpp isn't at the Docker image's default
# path (/opt/whisper/whisper-cli + ggml-tiny.bin, a multilingual model so
# Hindi audio transcribes correctly too, not just English). Powers
# word-by-word captions for platforms that don't provide their own
# (Instagram, and Twitter/TikTok when that specific video has none) by
# transcribing the downloaded file locally, and on the Search page's live
# preview when YouTube itself has no auto-captions for that video. Leave
# unset in local dev — those captions just stay empty, exactly like before
# this existed.
# WHISPER_BIN=/opt/whisper/whisper-cli
# WHISPER_MODEL=/opt/whisper/ggml-tiny.bin
